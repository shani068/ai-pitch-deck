# Copy this file to `.env` and replace the placeholders with your Neon connection strings
# (Neon console > Connect). Requires PostgreSQL >= 15. Never commit `.env`.

# Neon connection string (pooled or direct). The app and the Prisma CLI always connect to
# Neon's DIRECT endpoint: a pooled host's "-pooler" suffix is removed (src/prisma/connection-url.ts),
# because Neon's pooler rejects Prisma 8's session startup settings.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional. An explicit direct connection string; overrides the one derived from DATABASE_URL.
# DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Slide images. "true" (the default when unset) uses Picsum placeholders and calls neither OpenAI
# nor ImageKit; "false" generates each image with OpenAI and hosts it on ImageKit.
USE_PLACEHOLDER_IMAGES="true"

# OpenAI API key, used for deck text (always) and slide images (only when USE_PLACEHOLDER_IMAGES="false").
OPENAI_API_KEY="sk-your-openai-api-key"

# ImageKit private key, needed only when USE_PLACEHOLDER_IMAGES="false".
IMAGEKIT_PRIVATE_KEY="private_your-imagekit-private-key"
