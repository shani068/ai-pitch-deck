// use prisma-8

enum DeckStatus {
  PENDING
  GENERATING
  COMPLETE
  FAILED
}

model Deck {
  id           String     @id @onCreate(cuid(2))
  idea         String       
  title        String?
  status       DeckStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime   @default(now())
  updatedAt    temporal.UpdatedAt
  slides       Slide[]
}

model Slide {
  id          String   @id @onCreate(cuid(2))
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  content     String    
  imagePrompt String    
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([deckId])
}